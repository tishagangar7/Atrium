# Copy to backend/.env (git-ignored). Never commit real values (AGENTS.md invariant 10).

# Runtime model provider for the three negotiation agents (WS-B decision, PRD §3.5).
# One of: anthropic | openai | gemini (gemini has a genuinely free tier -- aistudio.google.com)
MODEL_PROVIDER=
RESCUEMESH_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enables the labeled test provider for protocol tests only (PRD §6, AGENTS.md invariant 8).
RESCUEMESH_TEST=0

PORT=8000
